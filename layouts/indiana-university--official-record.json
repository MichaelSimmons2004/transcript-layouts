      "points": 3.3,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "B",
      "points": 3.0,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "B-",
      "points": 2.7,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "C+",
      "points": 2.3,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "C",
      "points": 2.0,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "C-",
      "points": 1.7,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "D+",
      "points": 1.3,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "D",
      "points": 1.0,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "D-",
      "points": 0.7,
      "description": null,
      "counts_in_gpa": true
    },
    {
      "grade": "F",
      "points": 0.0,
      "description": "Failing",
      "counts_in_gpa": true
    },
    {
      "grade": "WF",
      "points": 0.0,
      "description": "Withdrawn-Failing (discontinued First Semester 1977-78)",
      "counts_in_gpa": true
    },
    {
      "grade": "AU",
      "points": null,
      "description": "Audit, no credit (discontinued 1965)",
      "counts_in_gpa": false
    },
    {
      "grade": "AX-DX",
      "points": null,
      "description": "Graded course (including plus and minus grades) subsequently retaken under the Extended-X Policy (effective Fall 1994 through Fall 2021)",
      "counts_in_gpa": false
    },
    {
      "grade": "CF",
      "points": null,
