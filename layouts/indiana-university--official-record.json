    {
      "grade": "X",
      "points": null,
      "description": "Passed Without Grade (discontinued 1965); from Fall 2021, retaken/replaced grade",
      "counts_in_gpa": false
    }
  ],
  "notes": [
    "Read by App-parser (IU 'Official Record' layout, no AI). Course titles are shown in title case; all other values are as printed."
  ]
}
